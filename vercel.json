{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/p/:id",
      "destination": "/api/p?id=:id"
    },
    {
      "source": "/catalogo",
      "destination": "/api/c"
    },
    {
      "source": "/catalogo/:cat",
      "destination": "/api/c?cat=:cat"
    },
    {
      "source": "/outlet",
      "destination": "/api/c?cat=outlet"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
